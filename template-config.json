{
  "services": {
    "8f3c2a61-5d4e-4b7a-9c1f-2e6d8a0b4c71": {
      "icon": "https://raw.githubusercontent.com/two-workspaces/pocketbase/main/icon.svg",
      "name": "PocketBase",
      "build": {
        "dockerfilePath": "Dockerfile"
      },
      "deploy": {
        "startCommand": null,
        "healthcheckPath": "/api/health",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      },
      "source": {
        "repo": "https://github.com/two-workspaces/pocketbase",
        "rootDirectory": null
      },
      "networking": {
        "serviceDomains": {
          "<hasDomain>": {}
        }
      },
      "volumeMounts": {
        "3b9e7d24-1a6c-4f58-8e2b-7c4d9f0a1e35": {
          "mountPath": "/pb_data"
        }
      },
      "variables": {
        "PB_ADMIN_EMAIL": {
          "defaultValue": "",
          "description": "Email you sign in to the dashboard with - the superuser is created on first boot",
          "isOptional": false
        },
        "PB_ADMIN_PASSWORD": {
          "defaultValue": "${{secret(24)}}",
          "description": "Superuser password, used on first boot only - change it later in the dashboard",
          "isOptional": false
        },
        "PB_APP_URL": {
          "defaultValue": "https://${{RAILWAY_PUBLIC_DOMAIN}}",
          "description": "Public URL used in emails and OAuth2 redirects, set on first boot - change it later in Settings",
          "isOptional": false
        },
        "PB_ENCRYPTION_KEY": {
          "defaultValue": "${{secret(32)}}",
          "description": "Encrypts stored settings (SMTP, S3, OAuth2 secrets) - never change it after the first boot",
          "isOptional": false
        },
        "PORT": {
          "defaultValue": "8090",
          "description": "Port Railway routes to - leave as is",
          "isOptional": false
        }
      }
    }
  }
}
